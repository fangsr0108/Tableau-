            <value>0.25</value>
          </bin>
          <bin default-name='true' value='&quot;0.4&quot;'>
            <value>0.40000000000000002</value>
          </bin>
          <bin default-name='true' value='&quot;0.6 和 0.8&quot;'>
            <value>0.59999999999999998</value>
            <value>0.80000000000000004</value>
          </bin>
        </calculation>
      </column>
      <column aggregation='Sum' datatype='real' name='[折扣]' role='dimension' type='ordinal' />
