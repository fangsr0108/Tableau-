      <aliases enabled='yes' />
      <column caption='每个订单的平均利润' datatype='real' name='[Calculation_0352671957815308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([利润])/COUNTD([订单ID])' />
      </column>
      <column caption='毛利率' datatype='real' default-format='p0.00%' name='[Calculation_0604183495098369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([利润])/SUM([销售额])' />
      </column>
      <column caption='commerce_order_alter.csv' datatype='table' name='[__tableau_internal_object_id__].[commerce_order_alter.csv_74B3BFF08E9D4E78B8CBAA5B1C294427]' role='measure' type='quantitative' />
      <column datatype='string' name='[产品id]' role='dimension' type='nominal' />
